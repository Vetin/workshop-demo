{
  "gateConfigurations": {
    "fast": {
      "name": "Fast Gate (2-3 minutes)",
      "description": "Quick validation for pre-commit and PR checks",
      "duration": "2-3 minutes",
      "cost": "low",
      "stages": [
        {
          "name": "Spell Check",
          "command": "make misspell",
          "timeout": 30,
          "critical": true,
          "description": "Verify spelling in documentation"
        },
        {
          "name": "Markdown Lint",
          "command": "make markdownlint",
          "timeout": 60,
          "critical": true,
          "description": "Validate markdown formatting"
        },
        {
          "name": "YAML Lint",
          "command": "make yamllint",
          "timeout": 60,
          "critical": true,
          "description": "Validate YAML files"
        },
        {
          "name": "License Headers",
          "command": "make checklicense",
          "timeout": 60,
          "critical": false,
          "description": "Verify license headers on source files"
        },
        {
          "name": "Link Check",
          "command": "make checklinks",
          "timeout": 120,
          "critical": false,
          "description": "Validate documentation links"
        }
      ],
      "failFast": true,
      "recommendedFor": [
        "Pre-commit validation",
        "Pull request checks",
        "Quick feedback loops",
        "Documentation changes"
      ]
    },
    "medium": {
      "name": "Medium Gate (5-8 minutes)",
      "description": "Comprehensive validation for feature branches and pre-merge",
      "duration": "5-8 minutes",
      "cost": "medium",
      "stages": [
        {
          "name": "All Fast Checks",
          "command": "make check",
          "timeout": 180,
          "critical": true,
          "description": "Run all linting and validation checks"
        },
        {
          "name": "Protobuf Generation",
          "command": "make docker-generate-protobuf",
          "timeout": 300,
          "critical": true,
          "description": "Regenerate protobuf bindings"
        },
        {
          "name": "Clean Work Tree Check",
          "command": "make check-clean-work-tree",
          "timeout": 30,
          "critical": true,
          "description": "Verify no uncommitted protobuf changes"
        },
        {
          "name": "Docker Image Build",
          "command": "make build",
          "timeout": 1200,
          "critical": true,
          "description": "Build all service Docker images"
        }
      ],
      "failFast": true,
      "requiresDocker": true,
      "recommendedFor": [
        "Feature branch validation",
        "Pre-merge checks",
        "Service code changes",
        "Dockerfile modifications",
        "Protobuf changes"
      ]
    },
    "full": {
      "name": "Full Gate (30-60 minutes)",
      "description": "Complete validation including integration tests",
      "duration": "30-60 minutes",
      "cost": "high",
      "stages": [
        {
          "name": "All Medium Checks",
          "command": "make check && make docker-generate-protobuf && make build",
          "timeout": 1800,
          "critical": true,
          "description": "Run linting, generation, and build"
        },
        {
          "name": "Full Stack Startup",
          "command": "make start",
          "timeout": 300,
          "critical": true,
          "description": "Start complete OpenTelemetry demo stack"
        },
        {
          "name": "Trace-Based Tests",
          "command": "make run-tracetesting",
          "timeout": 900,
          "critical": true,
          "description": "Run all service trace validation tests"
        },
        {
          "name": "Frontend Tests",
          "command": "make run-tests",
          "timeout": 900,
          "critical": false,
          "description": "Run frontend and integration tests"
        },
        {
          "name": "Cleanup",
          "command": "make stop",
          "timeout": 60,
          "critical": false,
          "description": "Stop and clean up resources"
        }
      ],
      "failFast": false,
      "requiresDocker": true,
      "recommendedFor": [
        "Release preparation",
        "Major feature validation",
        "After code review approval",
        "Before merging to main",
        "Performance validation"
      ]
    }
  },
  "commands": {
    "full_test_commands": [
      "make run-tests",
      "make run-tracetesting"
    ],
    "frontend_test_commands": [
      "cd src/frontend && npm run cy:open",
      "docker-compose -f docker-compose-tests.yml run frontendTests"
    ],
    "backend_integration_test_commands": [
      "make run-tracetesting",
      "make run-tracetesting SERVICES_TO_TEST=ad",
      "make run-tracetesting SERVICES_TO_TEST=cart",
      "make run-tracetesting SERVICES_TO_TEST=checkout",
      "make run-tracetesting SERVICES_TO_TEST=currency",
      "make run-tracetesting SERVICES_TO_TEST=email",
      "make run-tracetesting SERVICES_TO_TEST=payment",
      "make run-tracetesting SERVICES_TO_TEST=product-catalog",
      "make run-tracetesting SERVICES_TO_TEST=product-reviews",
      "make run-tracetesting SERVICES_TO_TEST=recommendation",
      "make run-tracetesting SERVICES_TO_TEST=shipping"
    ],
    "trace_based_test_commands": [
      "make run-tracetesting",
      "docker-compose -f docker-compose-tests.yml run traceBasedTests"
    ],
    "service_specific_commands": {
      "frontend": [
        "cd src/frontend && npm run dev",
        "cd src/frontend && npm run build",
        "cd src/frontend && npm start",
        "cd src/frontend && npm run lint",
        "cd src/frontend && npm run grpc:generate"
      ],
      "payment": [
        "cd src/payment && npm start"
      ],
      "react_native_app": [
        "cd src/react-native-app && npm start",
        "cd src/react-native-app && npm run android",
        "cd src/react-native-app && npm run ios",
        "cd src/react-native-app && npm run web",
        "cd src/react-native-app && npm test",
        "cd src/react-native-app && npm run lint"
      ],
      "ad_service": [
        "cd src/ad && gradle build"
      ]
    },
    "build_commands": [
      "make build",
      "make build-and-push",
      "make build-multiplatform",
      "make build-multiplatform-and-push",
      "make clean-images"
    ],
    "formatting_and_linting_commands": [
      "make check",
      "make misspell",
      "make misspell-correction",
      "make markdownlint",
      "make yamllint",
      "make checklicense",
      "make addlicense",
      "make checklinks",
      "make fix"
    ],
    "expensive_commands": [
      {
        "command": "make build",
        "duration": "10-20 minutes",
        "reason": "Rebuilds all 20+ service Docker images"
      },
      {
        "command": "make build-multiplatform",
        "duration": "20-40 minutes",
        "reason": "Builds for multiple architectures (amd64, arm64)"
      },
      {
        "command": "make build-multiplatform-and-push",
        "duration": "25-45 minutes",
        "reason": "Builds multiplatform and pushes to registry"
      },
      {
        "command": "make run-tests",
        "duration": "10-15 minutes",
        "reason": "Runs frontend tests and all trace-based tests"
      },
      {
        "command": "make run-tracetesting",
        "duration": "8-12 minutes",
        "reason": "Validates traces for all 11 services"
      }
    ]
  },
  "services": {
    "available_services": [
