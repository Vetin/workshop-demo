      "ad",
      "cart",
      "checkout",
      "currency",
      "email",
      "flagd",
      "flagd-ui",
      "fraud-detection",
      "frontend",
      "frontend-proxy",
      "grafana",
      "image-provider",
      "jaeger",
      "kafka",
      "llm",
      "load-generator",
      "opensearch",
      "otel-collector",
      "payment",
      "postgresql",
      "product-catalog",
      "product-reviews",
      "prometheus",
      "quote",
      "recommendation",
      "shipping",
      "valkey-cart"
    ],
    "services_with_trace_tests": [
      "ad",
      "cart",
      "checkout",
      "currency",
      "email",
      "frontend",
      "payment",
      "product-catalog",
      "product-reviews",
      "recommendation",
      "shipping"
    ],
    "service_languages": {
      "Go": [
        "cart",
        "checkout",
        "currency",
        "product-catalog"
      ],
      "Python": [
        "email",
        "llm",
        "load-generator",
        "product-reviews",
        "recommendation"
      ],
      "Java": [
        "ad"
      ],
      "CSharp": [
        "accounting",
        "fraud-detection",
        "quote"
      ],
      "Node.js": [
        "frontend",
        "payment"
      ],
      "Rust": [
        "shipping"
      ],
      "TypeScript": [
        "react-native-app"
      ]
    }
  },
  "stack_configurations": {
    "full_stack": {
      "command": "make start",
      "docker_compose_file": "docker-compose.yml",
      "services": 28,
      "startup_time": "1-2 minutes",
      "access_points": {
        "demo_ui": "http://localhost:8080",
        "jaeger": "http://localhost:8080/jaeger/ui",
        "grafana": "http://localhost:8080/grafana/",
        "load_generator": "http://localhost:8080/loadgen/",
        "feature_flags": "http://localhost:8080/feature/"
      }
    },
    "minimal_stack": {
      "command": "make start-minimal",
      "docker_compose_file": "docker-compose.minimal.yml",
      "services": "reduced",
      "startup_time": "30-60 seconds",
      "use_case": "Local development, faster iteration"
    },
    "test_infrastructure": {
      "command": "docker-compose -f docker-compose-tests.yml up",
      "docker_compose_file": "docker-compose-tests.yml",
      "includes": [
        "frontendTests",
        "traceBasedTests",
        "tracetest-server",
        "tracetest-postgres"
      ]
    }
  },
  "protobuf": {
    "source_file": "pb/demo.proto",
    "generation_commands": [
      "make generate-protobuf",
      "make docker-generate-protobuf",
      "make clean"
    ],
    "generated_outputs": {
      "go_checkout": "src/checkout/genproto/oteldemo/",
      "go_product_catalog": "src/product-catalog/genproto/oteldemo/",
      "python_recommendation": "src/recommendation/demo_pb2*",
      "typescript_frontend": "src/frontend/protos/demo.ts"
    }
  },
  "ci_cd": {
    "workflows": [
      {
        "name": "checks.yml",
        "trigger": "push to main, PR, manual",
        "checks": [
          "markdownlint",
          "yamllint",
          "misspell",
          "checklicense",
          "build_images"
        ]
      },
      {
        "name": "run-integration-tests.yml",
        "trigger": "PR review approval",
        "commands": [
          "make build",
          "docker system prune -f",
          "make run-tracetesting"
        ]
      },
      {
        "name": "component-build-images.yml",
        "trigger": "reusable workflow",
        "checks": [
          "protobuf generation",
          "clean work tree",
          "docker build matrix"
        ]
      }
    ]
  }
}
